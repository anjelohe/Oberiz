[Unit]
Description=Oberiz media automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oberiz
Group=oberiz
WorkingDirectory=/opt/oberiz
Environment=OBERIZ_DATA_DIR=/var/lib/oberiz/data
Environment=OBERIZ_CONFIG_DIR=/var/lib/oberiz/config
Environment=OBERIZ_STATIC_DIR=/opt/oberiz/frontend
ExecStart=/opt/oberiz/oberiz
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
